# Copy to .env and fill in. .env is gitignored.
# uv run --env-file .env jupyter nbconvert --execute --inplace src/preempt/demo.ipynb

# Hugging Face model id, or a local directory that contains model.onnx.
PREEMPT_MODEL_PATH=

# FF3 key and tweak, as hex. The key is 32, 48, or 64 hex characters
# (128, 192, or 256 bits). The tweak is 16 hex characters (64 bits).
# Anyone with this pair can reverse FPE names and amounts.
# Generate a pair with:
#   uv run python -c "from preempt import generate_key; print(*generate_key())"
PREEMPT_KEY=
PREEMPT_TWEAK=
